# Read-only RH-P12-RN(A) timing prerequisites; output bytes 15..23 only.
# Source: https://emanual.robotis.com/docs/en/platform/rh_p12_rna/
# Modbus wire address = documented 40xxx - 40001; u32 uses low word first.
def crc16(d):
    c = 0xFFFF
    for b in d:
        c = c ^ b
        for i in range(8):
            if c & 1:
                c = (c >> 1) ^ 0xA001
            else:
                c = c >> 1
    return c

def read_words(addr, count):
    d = [1, 3, (addr >> 8) & 255, addr & 255, 0, count]
    c = crc16(d)
    flange_serial_write(bytes(d + [c & 255, (c >> 8) & 255]))
    res, rx = flange_serial_read(0.5)
    expected = 5 + 2 * count
    if res != expected or len(rx) != expected:
        set_output_register_int(15, 240)
        flange_serial_close()
        exit()
    c = crc16(rx[:-2])
    if rx[0] != 1 or rx[1] != 3 or rx[2] != 2 * count or rx[-2] != (c & 255) or rx[-1] != ((c >> 8) & 255):
        set_output_register_int(15, 241)
        flange_serial_close()
        exit()
    vals = []
    for i in range(count):
        vals.append(rx[3 + i * 2] * 256 + rx[4 + i * 2])
    return vals

def page(number, payload):
    set_output_register_int(15, 0)
    for i in range(8):
        set_output_register_int(16 + i, payload[i])
    set_output_register_int(15, number)
    wait(2.0)

def word_bytes(v):
    return [(v >> 8) & 255, v & 255]


def fail(marker):
    set_output_register_int(15, marker)
    flange_serial_close()
    exit()

def write_checked(pdu):
    c = crc16(pdu)
    flange_serial_write(bytes(pdu + [c & 255, (c >> 8) & 255]))
    res, rx = flange_serial_read(0.5)
    if res != 8 or len(rx) != 8:
        fail(242)
    c = crc16(rx[:-2])
    if list(rx[:6]) != pdu[:6] or rx[-2] != (c & 255) or rx[-1] != ((c >> 8) & 255):
        fail(243)

def position():
    v = read_words(290, 2)
    return v[0] + 65536 * v[1]

def move_checked(target, number):
    write_checked([1, 16, 1, 26, 0, 2, 4, (target >> 8) & 255, target & 255, 0, 0])
    reached = False
    for i in range(200):
        if read_words(259, 1)[0] & 255:
            fail(244)
        pos = position()
        if abs(pos - target) <= 3:
            reached = True
            break
        wait(0.05)
    if not reached:
        page(number, word_bytes(target) + word_bytes(pos) + [0, 0, 0, 0])
        fail(245)
    wait(0.2)
    pos = position()
    cur = read_words(287, 1)[0]
    page(number, word_bytes(target) + word_bytes(pos) + word_bytes(cur) + [1, 0])

set_output_register_int(15, 0)
flange_serial_open(baudrate=57600, bytesize=DR_EIGHTBITS, parity=DR_PARITY_NONE, stopbits=DR_STOPBITS_ONE)
if read_words(0, 1)[0] != 35074:
    fail(246)
if (read_words(5, 1)[0] >> 8) != 5 or read_words(256, 1)[0] != 1:
    fail(247)
if read_words(259, 1)[0] & 255 or position() > 3:
    fail(248)
write_checked([1, 6, 1, 19, 0, 200])
move_checked(500, 1)
move_checked(0, 2)
flange_serial_close()
set_output_register_int(15, 250)
