diff --git a/tools/robot/hover_predicted.py b/tools/robot/hover_predicted.py
new file mode 100644
index 0000000..4e9e2e0
--- /dev/null
+++ b/tools/robot/hover_predicted.py
@@ -0,0 +1,211 @@
+#!/usr/bin/env python3
+"""예측 해제 지점 위 비접촉 정지 시험(G4 사전 확인, 공깃돌 없음, [OFF] 입회 필수).
+
+실제 tracker·planner가 낸 MODE_PREDICTED 계획(해제 지점 XY·해제 시각)을 받아, 로봇을 그 XY 위 이동 높이
+(`travel_z_m`, 정지 투입과 같은 높이)로 직선 이동해 멈춰 두고, 뚜껑이 실제로 언제·어디로 지나가는지 기록한다.
+벨트를 따라 움직이지 않고, 그리퍼·DRL을 쓰지 않는다. 끝나면 대기 자세(park)로 돌아간다.
+
+  # 계획만(로봇 지령 없음): 고른 계획·정지 지점·IK만 출력
+  python3 tools/robot/hover_predicted.py --config records/calib/2026-11-09-planes/site.yaml
+  # 실행([OFF], 비상정지 담당 입회)
+  python3 tools/robot/hover_predicted.py --config records/calib/2026-11-09-planes/site.yaml --execute
+
+전제: 드라이버(`dsr01`), 카메라, vision·tracker·planner가 같은 ROS 도메인에서 떠 있다(`replay.launch.py`를
+bag 없이 `use_sim_time:=false`). 로봇 지령은 `motion/move_line` 두 번(정지 지점, park)뿐이다.
+멈추는 법: move_line 실행 중에는 Ctrl+C로 팔이 서지 않는다. 비상정지·펜던트로 멈춘다.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+import time
+
+import numpy as np
+
+
+def log(event: str, **fields) -> None:
+    print(json.dumps({'t': round(time.time(), 3), 'event': event, **fields}, ensure_ascii=False, default=str),
+          flush=True)
+
+
+def crossing(samples, x_line: float):
+    """(t, x, y) 표본에서 x가 x_line을 처음 넘는 시각과 그때 y를 선형 보간한다. 넘지 않으면 None."""
+    s = sorted(samples)
+    for (t0, x0, y0), (t1, x1, y1) in zip(s, s[1:]):
+        if (x0 - x_line) * (x1 - x_line) <= 0 and x0 != x1:
+            a = (x_line - x0) / (x1 - x0)
+            return t0 + a * (t1 - t0), y0 + a * (y1 - y0)
+    return None
+
+
+def move_time_s(dist_m: float, v_mps: float, a_mps2: float) -> float:
+    """사다리꼴 속도 직선 이동 시간(가감속 포함)."""
+    if dist_m <= v_mps * v_mps / a_mps2:
+        return 2.0 * np.sqrt(dist_m / a_mps2)
+    return dist_m / v_mps + v_mps / a_mps2
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
+    ap.add_argument('--config', action='append', default=[], help='static_pick_place 덮어쓰기 YAML')
+    ap.add_argument('--execute', action='store_true', help='실제 로봇을 움직인다([OFF], 입회 필수)')
+    ap.add_argument('--wait-plan-s', type=float, default=60.0, help='쓸 수 있는 계획을 기다리는 최대 시간')
+    ap.add_argument('--slack-s', type=float, default=1.0, help='도착 예상 뒤 해제 시각까지 최소 여유')
+    ap.add_argument('--after-s', type=float, default=3.0, help='해제 시각 뒤 더 지켜보는 시간')
+    ap.add_argument('--min-obs', type=int, default=10, help='SelectTarget 최소 관측 수')
+    ap.add_argument('--image', help='해제 시각에 카메라 프레임을 저장할 경로(.png)')
+    ap.add_argument('--wait-xy', type=float, nargs=2, metavar=('X', 'Y'),
+                    help='계획을 기다릴 벨트 위 대기 지점 XY [m](z = travel_z_m). --execute면 먼저 이리로 옮긴다')
+    args = ap.parse_args(argv)
+
+    import rclpy
+    from rclpy.duration import Duration
+    from drop_interfaces.action import DropTask
+    from drop_interfaces.msg import ObjectDetection, ObjectDetectionArray
+    from drop_interfaces.srv import ComputeIntercept, SelectTarget
+    from static_pick_place.doosan_client import DoosanClient, RobotError
+    from static_pick_place.pick_place import load_config, make_params
+    from static_pick_place.plan import DOWN_QUAT_XYZW
+
+    p = make_params(load_config(args.config))
+    rclpy.init()
+    node = rclpy.create_node('hover_predicted')
+    caps = []          # (t_stamp, x, y) robot_base, 뚜껑 검출
+    latest = {}
+
+    def on_dets(msg):
+        t = msg.header.stamp.sec + msg.header.stamp.nanosec * 1e-9
+        for d in msg.detections:
+            if d.object_class == ObjectDetection.CLASS_CAP and d.position_valid:
+                caps.append((t, d.position.x, d.position.y))
+
+    node.create_subscription(ObjectDetectionArray, 'objects/detections', on_dets, 10)
+    if args.image:
+        from sensor_msgs.msg import Image
+        node.create_subscription(Image, '/camera/camera/color/image_raw', lambda m: latest.__setitem__('img', m), 1)
+    sel = node.create_client(SelectTarget, 'tracking/select_target')
+    plan_cli = node.create_client(ComputeIntercept, 'planner/compute_intercept')
+    robot = DoosanClient(node, 'dsr01')
+
+    def now_s():
+        return node.get_clock().now().nanoseconds * 1e-9
+
+    def call(cli, req):
+        fut = cli.call_async(req)
+        rclpy.spin_until_future_complete(node, fut, timeout_sec=2.0)
+        return fut.result()
+
+    def spin_until(t_end):
+        while now_s() < t_end:
+            rclpy.spin_once(node, timeout_sec=0.01)
+
+    try:
+        if not (sel.wait_for_service(5.0) and plan_cli.wait_for_service(5.0)):
+            log('abort', reason='SERVICE_UNAVAILABLE', detail='tracking/select_target·planner/compute_intercept')
+            return 2
+        log('ready', status=robot.check_ready())
+        start, _ = robot.tcp_pose()
+        log('tcp', pos_m=[round(float(v), 4) for v in start])
+        if args.wait_xy is not None:
+            # 대기 자세에서 정지 지점까지 3.7~3.9 s라 계획의 해제 시각(약 3 s 앞)에 늦는다. 벨트 위 이동 높이에서 기다린다
+            wait = np.array([args.wait_xy[0], args.wait_xy[1], p.travel_z_m])
+            if not (p.x_min_m <= wait[0] <= p.x_max_m and p.y_min_m <= wait[1] <= p.y_max_m):
+                log('abort', reason='WAIT_OUT_OF_WORKSPACE', wait_m=wait.round(4).tolist())
+                return 2
+            j = robot.ik_joints(wait, DOWN_QUAT_XYZW)
+            if abs(j[2]) < p.j3_min_rad:
+                log('abort', reason='NEAR_REACH_LIMIT', step='wait', j3_rad=round(float(j[2]), 4))
+                return 2
+            log('wait_pose', wait_m=wait.round(4).tolist(), j3_rad=round(float(j[2]), 4),
+                move_s=round(move_time_s(float(np.linalg.norm(wait - start)), p.travel_v_mps, p.travel_a_mps2), 2))
+            if args.execute:
+                start = robot.move_line(wait, DOWN_QUAT_XYZW, p.travel_v_mps, p.travel_a_mps2)
+                log('done', step='wait', reached_m=[round(float(v), 4) for v in start])
+            else:
+                start = wait
+
+        chosen = None
+        t_give_up = time.monotonic() + args.wait_plan_s
+        step = 0
+        while chosen is None and time.monotonic() < t_give_up:
+            step += 1
+            stamp_now = node.get_clock().now()
+            deadline = (stamp_now + Duration(seconds=1.0)).to_msg()
+            r = call(sel, SelectTarget.Request(cycle_id='hover', step_id=step, deadline=deadline,
+                                               object_class=ObjectDetection.CLASS_CAP, min_observation_count=args.min_obs))
+            if r is None or r.result != 0:
+                time.sleep(0.2)
+                continue
+            c = call(plan_cli, ComputeIntercept.Request(cycle_id='hover', step_id=step, deadline=deadline,
+                                                        target_track_id=r.track_id, target_epoch=r.epoch,
+                                                        mode=DropTask.Goal.MODE_PREDICTED,
+                                                        earliest_release=stamp_now.to_msg()))
+            if c is None or c.result != 0 or c.plan.status != 0:
+                log('plan_rejected', track_id=r.track_id, reason=None if c is None else c.reason_code)
+                time.sleep(0.2)
+                continue
+            pl = c.plan
+            hover = np.array([pl.target_tcp_pose.position.x, pl.target_tcp_pose.position.y, p.travel_z_m])
+            t_release = pl.release_time.sec + pl.release_time.nanosec * 1e-9
+            t_move = move_time_s(float(np.linalg.norm(hover - start)), p.travel_v_mps, p.travel_a_mps2)
+            margin = t_release - now_s() - t_move
+            if not (p.x_min_m <= hover[0] <= p.x_max_m and p.y_min_m <= hover[1] <= p.y_max_m):
+                log('plan_skipped', reason='OUT_OF_WORKSPACE', hover_m=hover.round(4).tolist())
+                continue
+            if margin < args.slack_s:
+                log('plan_skipped', reason='TOO_LATE', margin_s=round(margin, 2), move_s=round(t_move, 2))
+                time.sleep(0.2)
+                continue
+            j = robot.ik_joints(hover, DOWN_QUAT_XYZW)
+            if abs(j[2]) < p.j3_min_rad:
+                log('plan_skipped', reason='NEAR_REACH_LIMIT', j3_rad=round(float(j[2]), 4))
+                continue
+            chosen = (pl, hover, t_release, t_move, margin, float(j[2]))
+        if chosen is None:
+            log('abort', reason='NO_USABLE_PLAN', waited_s=args.wait_plan_s)
+            return 2
+        pl, hover, t_release, t_move, margin, j3 = chosen
+        log('plan', plan_id=pl.plan_id, track_id=pl.target_track_id, hover_m=hover.round(4).tolist(),
+            release_xyz_m=[round(pl.target_tcp_pose.position.x, 4), round(pl.target_tcp_pose.position.y, 4),
+                           round(pl.target_tcp_pose.position.z, 4)],
+            cap_v_mps=[round(pl.target_velocity.x, 4), round(pl.target_velocity.y, 4)],
+            position_std_m=round(pl.position_std, 5), release_in_s=round(t_release - now_s(), 2),
+            move_s=round(t_move, 2), margin_s=round(margin, 2), j3_rad=round(j3, 4),
+            v_mps=p.travel_v_mps, a_mps2=p.travel_a_mps2)
+        if not args.execute:
+            log('dry_run_done')
+            return 0
+
+        reached = robot.move_line(hover, DOWN_QUAT_XYZW, p.travel_v_mps, p.travel_a_mps2)
+        t_arrive = now_s()
+        log('arrived', reached_m=[round(float(v), 4) for v in reached], before_release_s=round(t_release - t_arrive, 2))
+        spin_until(t_release)
+        if args.image and 'img' in latest:
+            import cv2
+            m = latest['img']
+            img = np.frombuffer(m.data, np.uint8).reshape(m.height, m.step)[:, :m.width * 3].reshape(m.height, m.width, 3)
+            cv2.imwrite(args.image, img[:, :, ::-1] if m.encoding == 'rgb8' else img)
+            log('image', path=args.image)
+        spin_until(t_release + args.after_s)
+        seen = [c for c in caps if c[0] >= t_release - 5.0]
+        cross = crossing(seen, hover[0])
+        if cross is None:
+            log('result', crossed=False, cap_samples=len(seen))
+        else:
+            t_cross, y_cross = cross
+            log('result', crossed=True, cross_minus_release_s=round(t_cross - t_release, 3),
+                y_at_cross_minus_hover_mm=round((y_cross - hover[1]) * 1000, 1), cap_samples=len(seen))
+        back = robot.move_line([p.park_x_m, p.park_y_m, p.park_z_m], DOWN_QUAT_XYZW, p.travel_v_mps, p.travel_a_mps2)
+        log('done', step='park', reached_m=[round(float(v), 4) for v in back])
+        return 0
+    except RobotError as exc:
+        log('abort', reason=exc.reason if hasattr(exc, 'reason') else 'ROBOT_ERROR', detail=str(exc))
+        return 2
+    finally:
+        node.destroy_node()
+        rclpy.shutdown()
+
+
+if __name__ == '__main__':
+    sys.exit(main())
