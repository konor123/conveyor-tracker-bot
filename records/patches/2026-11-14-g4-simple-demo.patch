From e66332c6865f3dc0950e5a2c0b533edd19c74748 Mon Sep 17 00:00:00 2001
From: chhowm <chhowm@gmail.com>
Date: Sat, 14 Nov 2026 11:19:35 +0900
Subject: [PATCH 03/18] Add a simple G4 demo script: grip with the resident
 loop, wait at the predicted release point, fire the armed open

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/robot/g4_simple.py | 246 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 246 insertions(+)
 create mode 100644 tools/robot/g4_simple.py

diff --git a/tools/robot/g4_simple.py b/tools/robot/g4_simple.py
new file mode 100644
index 0000000..de3a5e4
--- /dev/null
+++ b/tools/robot/g4_simple.py
@@ -0,0 +1,246 @@
+#!/usr/bin/env python3
+"""간이 G4: 공깃돌을 쥐고 예측 해제 지점에서 기다렸다가 예측 시각에 놓는다([OFF] 입회 필수, 시연용).
+
+정식 G4(orchestrator → robot_controller_node DynamicPlace)가 아니다. 놓는 순간 벨트를 따라 움직이지 않는다.
+쓰는 것: 정지 투입의 검출·직선 이동(`static_pick_place`), G4용 그리퍼 상주 루프의 예약 → 트리거
+(`robot_control.resident_transport`, 2026-11-14 현장에서 레지스터 0~23·쓰기 << 24 수정 뒤 동작 확인),
+hover 도구의 예측 계획 고르기(`tools/robot/hover_predicted.py`).
+
+  # 계획만(로봇·그리퍼 지령 없음): 고른 공깃돌·파지 높이·IK, 예측 계획과 해제 지점
+  python3 tools/robot/g4_simple.py --config records/calib/2026-11-09-planes/site.yaml
+  # 실행
+  python3 tools/robot/g4_simple.py --config records/calib/2026-11-09-planes/site.yaml --execute
+
+순서(--execute): 상주 루프 확인·기동 → 공깃돌 위 → 하강 → 닫기(150 mA) → 들기 → 벨트 옆 대기 →
+예측 계획 → 해제 지점(테두리 위 release_above_rim_m + --release-raise-m)으로 직선 이동 → 개방 예약 →
+해제 시각 − --lead-s에 트리거 → 0.5 s 뒤 들기 → park → 카메라로 투입 확인.
+멈추는 법: move_line 중에는 비상정지·펜던트. 실패하면 공깃돌이 벨트에 떨어질 수 있다.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+import time
+
+import numpy as np
+
+from tools.robot.hover_predicted import move_time_s
+
+MAT_Y_MAX_M = 0.02        # 매트 공깃돌 y 상한. 매트와 벨트 사이 빨간 LED 오검출(y ≈ +0.047 m, 2026-11-14)을 막는다
+
+
+def log(event: str, **fields) -> None:
+    print(json.dumps({'t': round(time.time(), 3), 'event': event, **fields}, ensure_ascii=False, default=str),
+          flush=True)
+
+
+class SteadyClock:
+    def steady_now(self) -> float:
+        return time.monotonic()
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
+    ap.add_argument('--config', action='append', default=[])
+    ap.add_argument('--execute', action='store_true')
+    ap.add_argument('--wait-xy', type=float, nargs=2, default=[0.66, 0.20])
+    ap.add_argument('--wait-plan-s', type=float, default=30.0)
+    ap.add_argument('--min-obs', type=int, default=30)
+    ap.add_argument('--slack-s', type=float, default=0.8, help='해제 지점 도착 예상 뒤 트리거까지 최소 여유')
+    ap.add_argument('--lead-s', type=float, default=0.2, help='해제 시각보다 이만큼 먼저 트리거(개방·낙하 시간)')
+    ap.add_argument('--release-raise-m', type=float, default=0.015, help='해제 높이에 더하는 여유(손가락·테두리 간격)')
+    args = ap.parse_args(argv)
+
+    import rclpy
+    from rclpy.duration import Duration
+    from drop_interfaces.action import DropTask
+    from drop_interfaces.msg import ObjectDetection
+    from drop_interfaces.srv import ComputeIntercept, SelectTarget
+    from robot_control.dsr_register_io import DsrRegisterIO, RosServiceCaller
+    from robot_control.gripper_adapter import MODBUS
+    from robot_control.resident_transport import ResidentLoopTransport, ResidentRegs
+    from static_pick_place.doosan_client import DoosanClient, RobotError
+    from static_pick_place.pick_place import detect, grab_frame, load_config, load_geometry, make_params
+    from static_pick_place.plan import DOWN_QUAT_XYZW, choose_stone
+
+    cfg = load_config(args.config)
+    p = make_params(cfg)
+    rclpy.init()
+    node = rclpy.create_node('g4_simple')
+    caller = RosServiceCaller('g4_simple_dsr_io')
+    io = DsrRegisterIO(caller, 'dsr01')
+    regs = ResidentRegs()
+    loop = ResidentLoopTransport(io, SteadyClock(), time.sleep, regs)
+    robot = DoosanClient(node, 'dsr01')
+    sel = node.create_client(SelectTarget, 'tracking/select_target')
+    plan_cli = node.create_client(ComputeIntercept, 'planner/compute_intercept')
+
+    def now_s():
+        return node.get_clock().now().nanoseconds * 1e-9
+
+    def call(cli, req):
+        fut = cli.call_async(req)
+        rclpy.spin_until_future_complete(node, fut, timeout_sec=2.0)
+        return fut.result()
+
+    def move(name, pos, v=None, a=None):
+        reached = robot.move_line(pos, DOWN_QUAT_XYZW, v or p.travel_v_mps, a or p.travel_a_mps2)
+        log('done', step=name, reached_m=[round(float(x), 4) for x in reached])
+        return reached
+
+    def ik_ok(name, pos) -> bool:
+        j = robot.ik_joints(pos, DOWN_QUAT_XYZW)
+        ok = abs(j[2]) >= p.j3_min_rad and p.x_min_m <= pos[0] <= p.x_max_m and p.y_min_m <= pos[1] <= p.y_max_m
+        log('check', step=name, pos_m=[round(float(x), 4) for x in pos], j3_rad=round(float(j[2]), 4), ok=ok)
+        return ok
+
+    def gripper_to(pulse, current_ma, timeout_s=8.0):
+        """루프로 그리퍼를 옮기고 도착하거나 1 s 멈출 때까지 기다린다. 실행 중에는 상태가 갱신되지 않는다."""
+        t0 = time.monotonic()
+        if not (loop.write_register(MODBUS.goal_current, current_ma) and loop.write_goal_position(pulse)
+                and loop.trigger()):
+            raise RuntimeError('GRIPPER_WRITE_FAILED')
+        samples = []
+        while time.monotonic() - t0 < timeout_s:
+            done = loop.last_command()
+            pos = loop._word(regs.st_pos_hi)
+            samples.append(pos)
+            if done and done[0] and (abs(pos - pulse) <= 5 or (time.monotonic() - t0 > 3.0
+                                                                 and len(set(samples[-4:])) == 1)):
+                break
+            time.sleep(0.25)
+        return loop._word(regs.st_pos_hi), done
+
+    try:
+        # ---------------- 상태·검출(지령 없음)
+        st = robot.status()
+        log('ready', status=st)
+        if st['robot_state'] != 1 or st['robot_mode'] != 1:
+            log('abort', reason='NOT_STANDBY_AUTONOMOUS')
+            return 2
+        start, _ = robot.tcp_pose()
+        geom = load_geometry(cfg)
+        dets = detect(grab_frame(node, cfg['image_topic']), cfg, geom)
+        excluded = [[round(v, 4) for v in d.position] for d in dets if d.position[1] > MAT_Y_MAX_M]
+        stone = choose_stone([d for d in dets if d.position[1] <= MAT_Y_MAX_M], p)
+        if excluded:
+            log('excluded', reason='Y_ABOVE_MAT', pos_m=excluded)
+        if stone is None:
+            log('abort', reason='NO_MAT_STONE')
+            return 2
+        s = np.asarray(stone.position, float)
+        over = np.array([s[0], s[1], p.travel_z_m])
+        grasp = np.array([s[0], s[1], s[2] + p.grasp_above_stone_top_m])
+        wait = np.array([args.wait_xy[0], args.wait_xy[1], p.travel_z_m])
+        log('stone', pos_m=[round(float(v), 4) for v in s])
+        if not all(ik_ok(n, q) for n, q in (('over_stone', over), ('grasp', grasp), ('wait', wait))):
+            log('abort', reason='IK_OR_WORKSPACE')
+            return 2
+
+        # ---------------- 파지(--execute)
+        if args.execute:
+            if io.get(regs.init) != 1 or robot.status()['drl_state'] != 0:
+                t0 = time.monotonic()
+                loop.start_resident_loop()
+                log('loop_started', ready_s=round(time.monotonic() - t0, 2))
+            pos, _ = gripper_to(p.open_pulse, 100)
+            log('gripper', step='open_before_pick', pulse=pos)
+            move('over_stone', over)
+            move('descend_grasp', grasp, p.vertical_v_mps, p.vertical_a_mps2)
+            pos, done = gripper_to(p.close_pulse, p.grip_current_ma)
+            log('gripper', step='close_grasp', pulse=pos, done=done)
+            if pos >= p.close_pulse - 10:
+                log('abort', reason='NO_STONE_IN_GRIP', pulse=pos)
+                move('lift_empty', over, p.vertical_v_mps, p.vertical_a_mps2)
+                move('park', [p.park_x_m, p.park_y_m, p.park_z_m])
+                return 2
+            move('lift_stone', over, p.vertical_v_mps, p.vertical_a_mps2)
+            start = move('wait', wait)
+        else:
+            start = wait
+
+        # ---------------- 예측 계획
+        if not (sel.wait_for_service(5.0) and plan_cli.wait_for_service(5.0)):
+            log('abort', reason='PLANNER_UNAVAILABLE')
+            return 2
+        chosen, fails, step = None, {}, 0
+        t_give_up = time.monotonic() + args.wait_plan_s
+        while chosen is None and time.monotonic() < t_give_up:
+            step += 1
+            stamp_now = node.get_clock().now()
+            deadline = (stamp_now + Duration(seconds=1.0)).to_msg()
+            r = call(sel, SelectTarget.Request(cycle_id='g4s', step_id=step, deadline=deadline,
+                                               object_class=ObjectDetection.CLASS_CAP, min_observation_count=args.min_obs))
+            if r is None or r.result != 0:
+                why = 'NO_REPLY' if r is None else r.reason_code
+                fails[why] = fails.get(why, 0) + 1
+                time.sleep(0.1)
+                continue
+            c = call(plan_cli, ComputeIntercept.Request(cycle_id='g4s', step_id=step, deadline=deadline,
+                                                        target_track_id=r.track_id, target_epoch=r.epoch,
+                                                        mode=DropTask.Goal.MODE_PREDICTED,
+                                                        earliest_release=stamp_now.to_msg()))
+            if c is None or c.result != 0 or c.plan.status != 0:
+                why = 'NO_REPLY' if c is None else c.reason_code
+                fails[why] = fails.get(why, 0) + 1
+                time.sleep(0.1)
+                continue
+            pl = c.plan
+            rel = np.array([pl.target_tcp_pose.position.x, pl.target_tcp_pose.position.y,
+                            pl.target_tcp_pose.position.z + args.release_raise_m])
+            t_release = pl.release_time.sec + pl.release_time.nanosec * 1e-9
+            t_move = move_time_s(float(np.linalg.norm(rel - start)), p.travel_v_mps, p.travel_a_mps2)
+            margin = t_release - args.lead_s - now_s() - t_move
+            if margin < args.slack_s:
+                fails['TOO_LATE'] = fails.get('TOO_LATE', 0) + 1
+                continue
+            if not (rel[2] < p.travel_z_m and ik_ok('release', rel)):
+                fails['RELEASE_POSE'] = fails.get('RELEASE_POSE', 0) + 1
+                continue
+            chosen = (pl, rel, t_release, t_move, margin)
+        if chosen is None:
+            log('abort', reason='NO_USABLE_PLAN', fails=fails)
+            if args.execute:
+                move('park_holding', [p.park_x_m, p.park_y_m, p.park_z_m])
+            return 2
+        pl, rel, t_release, t_move, margin = chosen
+        log('plan', track_id=pl.target_track_id, release_m=[round(float(v), 4) for v in rel],
+            cap_v_mps=[round(pl.target_velocity.x, 4), round(pl.target_velocity.y, 4)],
+            position_std_m=round(pl.position_std, 5), release_in_s=round(t_release - now_s(), 2),
+            move_s=round(t_move, 2), margin_s=round(margin, 2), lead_s=args.lead_s, fails=fails)
+        if not args.execute:
+            log('dry_run_done')
+            return 0
+
+        # ---------------- 해제
+        move('to_release', rel)
+        loop.write_register(MODBUS.goal_current, 100)
+        loop.write_goal_position(p.open_pulse)                 # 예약: 루프는 읽기를 멈추고 트리거만 기다린다
+        t_fire = t_release - args.lead_s
+        log('armed', fire_in_s=round(t_fire - now_s(), 3))
+        while now_s() < t_fire:
+            time.sleep(0.002)
+        loop.trigger()
+        log('fired', late_s=round(now_s() - t_fire, 3))
+        time.sleep(0.5)
+        move('retreat', [rel[0], rel[1], p.travel_z_m], p.vertical_v_mps, p.vertical_a_mps2)
+        move('park', [p.park_x_m, p.park_y_m, p.park_z_m])
+        time.sleep(0.5)
+        after = detect(grab_frame(node, cfg['image_topic']), cfg, geom)
+        caps = [{'pos_m': [round(v, 4) for v in d.position], 'stone_inside': d.stone_inside,
+                 'valid': d.stone_inside_valid} for d in after if d.blob.object_class == ObjectDetection.CLASS_CAP]
+        log('verify', caps=caps, result='SUCCESS' if any(c['stone_inside'] and c['valid'] for c in caps)
+            else 'NOT_VERIFIED')
+        return 0
+    except (RobotError, RuntimeError) as exc:
+        log('abort', reason=getattr(exc, 'reason', type(exc).__name__), detail=str(exc))
+        return 2
+    finally:
+        caller.close()
+        node.destroy_node()
+        rclpy.shutdown()
+
+
+if __name__ == '__main__':
+    sys.exit(main())
-- 
