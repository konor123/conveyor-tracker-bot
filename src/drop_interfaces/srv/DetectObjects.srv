# 공통 요청 필드
string cycle_id
uint32 step_id
builtin_interfaces/Time deadline   # ROS 시각. 지나면 서버가 스스로 중단하고 TIMEOUT
uint8 region            # ObjectDetection.REGION_MAT / REGION_BELT
uint8 object_class      # ObjectDetection.CLASS_STONE / CLASS_CAP
uint8 min_count
float64 stable_window   # [s] 이 시간 동안 안정적으로 보인 것만
---
# 공통 결과 코드
uint8 OK=0
uint8 FAILED=1          # 시도했으나 판정 실패
uint8 TIMEOUT=2         # deadline 경과
uint8 PRECONDITION=3    # 선행조건 불충족, 시도하지 않음
uint8 CANCELED=4
uint8 FAULT=5           # 하드웨어·통신 이상
uint8 result
string reason_code
ObjectDetection[] detections
float64[] position_std  # 창 안 위치 표준편차 [m]
