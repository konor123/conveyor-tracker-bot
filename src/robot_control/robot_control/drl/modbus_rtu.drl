def crc16(d):
    c = 0xFFFF
    for b in d:
        c = c ^ b
        for i in range(8):
            if c & 1:
                c = (c >> 1) ^ 0xA001
            else:
                c = c >> 1
    return c

def read_words(addr, count):
    d = [1, 3, (addr >> 8) & 255, addr & 255, 0, count]
    c = crc16(d)
    flange_serial_write(bytes(d + [c & 255, (c >> 8) & 255]))
    res, rx = flange_serial_read(READ_TIMEOUT)
    expected = 5 + 2 * count
    if res != expected or len(rx) != expected:
        return None
    c = crc16(rx[:-2])
    if rx[0] != 1 or rx[1] != 3 or rx[2] != 2 * count or rx[-2] != (c & 255) or rx[-1] != ((c >> 8) & 255):
        return None
    vals = []
    for i in range(count):
        vals.append(rx[3 + i * 2] * 256 + rx[4 + i * 2])
    return vals

def write_checked(pdu):
    c = crc16(pdu)
    flange_serial_write(bytes(pdu + [c & 255, (c >> 8) & 255]))
    res, rx = flange_serial_read(READ_TIMEOUT)
    if res != 8 or len(rx) != 8:
        return False
    c = crc16(rx[:-2])
    return list(rx[:6]) == pdu[:6] and rx[-2] == (c & 255) and rx[-1] == ((c >> 8) & 255)
