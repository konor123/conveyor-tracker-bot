# RH-P12-RN(A) 그리퍼 상주 루프(제어기 플랜지 RS-485, Modbus-RTU ID 1, 57600 8N1). 팔 지령·EEPROM 쓰기 없음.
# 초안: 실기 미실행(2026-11-10). 일회성 gripper_move.drl(2026-11-09 실기 검증)의 Modbus 함수를 그대로 쓴다.
# 실기 전 확인할 것: (1) PC가 set_output_register_int로 쓴 값을 DRL이 get_output_register_int로 읽을 수 있는지와
# 그 값의 해석, (2) 이 프로그램이 도는 동안 move_line·스트림 지령이 받아들여지는지, (3) 루프 안 왕복 시간.
#
# 레지스터 주소는 resident_transport.ResidentRegs에서 채운다(제어기 출력 정수 레지스터는 0~23만 받는다, 2026-11-14 현장).
#   PC → DRL(값 0~127): seq, 목표 위치(7비트 hi·lo), 목표 전류(7비트 hi·lo), 예약(1), 종료(1)
#   DRL → PC(값 0~255): 생존 카운터, 위치 hi·lo, 전류 hi·lo(16비트 2의 보수), 오류 비트,
#                        시작 상태(0 준비 중, 1 정상, 241 무응답, 246 모델, 247 모드, 244 오류 비트),
#                        Operating Mode, 펌웨어, 실행한 seq, 그 seq의 결과(0 정상, 242 쓰기 실패. 실행한 seq보다 먼저 쓴다)
READ_TIMEOUT = __READ_TIMEOUT__
SPIN = __SPIN__
ARM_TIMEOUT = __ARM_TIMEOUT__

__MODBUS_RTU__

def reg7(hi_addr):
    return (get_output_register_int(hi_addr) & 127) * 128 + (get_output_register_int(hi_addr + 1) & 127)

def publish_state():
    # 287 Present Current, 288~289 Present Velocity, 290~291 Present Position(u32, 낮은 word 먼저)
    v = read_words(287, 5)
    if v is None:
        return False
    set_output_register_int(__R_ST_POS_HI__, (v[3] >> 8) & 255)
    set_output_register_int(__R_ST_POS_LO__, v[3] & 255)
    set_output_register_int(__R_ST_CUR_HI__, (v[0] >> 8) & 255)
    set_output_register_int(__R_ST_CUR_LO__, v[0] & 255)
    return True

def init():
    flange_serial_read(READ_TIMEOUT)                # 지난 실행의 늦은 응답을 비운다
    ident = read_words(0, 6)                        # 0 Model Number, 3 Firmware, 5 상위 바이트 Operating Mode
    if ident is None:
        return 241
    set_output_register_int(__R_MODE__, (ident[5] >> 8) & 255)
    set_output_register_int(__R_FIRMWARE__, ident[3] & 255)
    if ident[0] != 35074:
        return 246
    if (ident[5] >> 8) != 5:
        return 247
    ram = read_words(256, 20)                       # 256 Torque Enable, 259 Hardware Error, 275 Goal Current
    if ram is None:
        return 241
    set_output_register_int(__R_ERROR__, ram[3] & 255)
    if ram[3] & 255:
        return 244
    if ram[0] != 1 and not write_checked([1, 6, 1, 0, 0, 1]):
        return 241
    if not publish_state():
        return 241
    return 1

def write_current(cur):
    return write_checked([1, 6, 1, 19, (cur >> 8) & 255, cur & 255])

def write_position(pos):
    return write_checked([1, 16, 1, 26, 0, 2, 4, (pos >> 8) & 255, pos & 255, 0, 0])

def run():
    alive = 0
    done_seq = get_output_register_int(__R_SEQ__) & 127    # 기동 전에 남아 있던 seq는 실행하지 않는다
    set_output_register_int(__R_DONE_SEQ__, done_seq)
    goal_current = -1
    armed_since = -1.0
    polls = 0
    while (get_output_register_int(__R_STOP__) & 127) != 1:
        seq = get_output_register_int(__R_SEQ__) & 127
        if seq != done_seq:
            result = 0
            cur = reg7(__R_CUR_HI__)
            if cur != goal_current:
                if write_current(cur):
                    goal_current = cur
                else:
                    result = 242                     # 전류를 못 바꿨으면 위치도 쓰지 않는다
            if result == 0 and not write_position(reg7(__R_POS_HI__)):
                result = 242
            done_seq = seq
            set_output_register_int(__R_CMD_RESULT__, result)
            set_output_register_int(__R_DONE_SEQ__, done_seq)
            set_output_register_int(__R_ARM__, 0)
            armed_since = -1.0
        elif (get_output_register_int(__R_ARM__) & 127) == 1 and (armed_since < 0.0 or armed_since < ARM_TIMEOUT):
            # 예약 상태: 전류만 미리 맞추고 Modbus 읽기를 멈춘 채 seq만 지켜본다(트리거 지연 = SPIN + 쓰기 1회)
            cur = reg7(__R_CUR_HI__)
            if cur != goal_current and write_current(cur):
                goal_current = cur
            if armed_since < 0.0:
                armed_since = 0.0
            armed_since = armed_since + SPIN
            wait(SPIN)
            alive = (alive + 1) & 255
            set_output_register_int(__R_ALIVE__, alive)
        else:
            if publish_state():
                polls = polls + 1
                if polls % 10 == 0:
                    err = read_words(259, 1)
                    if err is not None:
                        set_output_register_int(__R_ERROR__, err[0] & 255)
                alive = (alive + 1) & 255
                set_output_register_int(__R_ALIVE__, alive)   # 생존 카운터는 새 상태를 올렸을 때(또는 예약 대기 중)만 오른다

set_output_register_int(__R_INIT__, 0)
set_output_register_int(__R_ARM__, 0)
set_output_register_int(__R_STOP__, 0)
set_output_register_int(__R_CMD_RESULT__, 0)
flange_serial_open(baudrate=57600, bytesize=DR_EIGHTBITS, parity=DR_PARITY_NONE, stopbits=DR_STOPBITS_ONE)
status = init()
set_output_register_int(__R_INIT__, status)
if status == 1:
    run()
flange_serial_close()
