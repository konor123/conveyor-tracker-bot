# Read-only RH-P12-RN(A) timing prerequisites; output bytes 15..23 only.
# Source: https://emanual.robotis.com/docs/en/platform/rh_p12_rna/
# Modbus wire address = documented 40xxx - 40001; u32 uses low word first.
def crc16(d):
    c = 0xFFFF
    for b in d:
        c = c ^ b
        for i in range(8):
            if c & 1:
                c = (c >> 1) ^ 0xA001
            else:
                c = c >> 1
    return c

def read_words(addr, count):
    d = [1, 3, (addr >> 8) & 255, addr & 255, 0, count]
    c = crc16(d)
    flange_serial_write(bytes(d + [c & 255, (c >> 8) & 255]))
    res, rx = flange_serial_read(0.5)
    expected = 5 + 2 * count
    if res != expected or len(rx) != expected:
        set_output_register_int(15, 240)
        flange_serial_close()
        exit()
    c = crc16(rx[:-2])
    if rx[0] != 1 or rx[1] != 3 or rx[2] != 2 * count or rx[-2] != (c & 255) or rx[-1] != ((c >> 8) & 255):
        set_output_register_int(15, 241)
        flange_serial_close()
        exit()
    vals = []
    for i in range(count):
        vals.append(rx[3 + i * 2] * 256 + rx[4 + i * 2])
    return vals

def page(number, payload):
    set_output_register_int(15, 0)
    for i in range(8):
        set_output_register_int(16 + i, payload[i])
    set_output_register_int(15, number)
    wait(2.0)

def word_bytes(v):
    return [(v >> 8) & 255, v & 255]

set_output_register_int(15, 0)
flange_serial_open(baudrate=57600, bytesize=DR_EIGHTBITS, parity=DR_PARITY_NONE, stopbits=DR_STOPBITS_ONE)
v = read_words(278, 4)
page(1, word_bytes(v[0]) + word_bytes(v[1]) + word_bytes(v[2]) + word_bytes(v[3]))
lim = read_words(19, 3)
mode = read_words(5, 1)[0]
err = read_words(259, 1)[0]
page(2, word_bytes(lim[0]) + word_bytes(lim[1]) + word_bytes(lim[2]) + [(mode >> 8) & 255, err & 255])
vlim = read_words(22, 2)
gcur = read_words(275, 1)[0]
torque = read_words(256, 1)[0]
watchdog = read_words(273, 1)[0]
page(3, word_bytes(vlim[0]) + word_bytes(vlim[1]) + word_bytes(gcur) + [torque & 255, watchdog & 255])
a = read_words(284, 8)
wait(0.1)
b = read_words(284, 8)
delta = (b[0] - a[0]) % 32768
page(4, word_bytes(delta) + word_bytes(b[6]) + word_bytes(b[7]) + word_bytes(b[3]))
flange_serial_close()
set_output_register_int(15, 250)
